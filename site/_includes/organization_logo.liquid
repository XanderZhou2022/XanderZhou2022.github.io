{% assign organization = null %}
{% for candidate in site.data.organizations %}
  {% if include.name contains candidate.match -%}
    {%- assign organization = candidate -%}
    {%- break -%}
  {%- endif %}
{% endfor %}
<div class="experience-logo">
  {% if organization %}
    {% assign light_path = organization.image | prepend: '/assets/img/organizations/' %}
    {% assign dark_path = organization.dark_image | default: organization.image | prepend: '/assets/img/organizations/' %}
    {% capture logo_alt %}{{ organization.name }} logo{% endcapture %}
    {% include optimized_image.liquid path=light_path class="organization-logo-light" sizes="56px" alt=logo_alt %}
    {% include optimized_image.liquid path=dark_path class="organization-logo-dark" sizes="56px" alt=logo_alt %}
  {% else %}
    <i class="{{ include.icon | default: 'fa-solid fa-building-columns' }}" aria-hidden="true"></i>
  {% endif %}
</div>
