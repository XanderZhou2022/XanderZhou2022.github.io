{% assign optimized = site.data.optimized_images[include.path] %}
<img
  src="{{ optimized.src | default: include.path | relative_url }}"
  {% if optimized %}
    srcset="{% assign variants = optimized.srcset | split: ', ' %}{% for variant in variants %}{% assign parts = variant | split: ' ' %}{{ parts.first | relative_url }} {{ parts.last }}{% unless forloop.last %}, {% endunless %}{% endfor %}"
    sizes="{{ include.sizes | default: '(max-width: 575px) calc(100vw - 64px), 300px' }}"
    width="{{ optimized.width }}"
    height="{{ optimized.height }}"
  {% else %}
    width="640"
    height="400"
  {% endif %}
  {% if include.class %}
    class="{{ include.class }}"
  {% endif %}
  alt="{{ include.alt | escape }}"
  loading="{{ include.loading | default: 'eager' }}"
  {% if include.priority %}
    fetchpriority="{{ include.priority }}"
  {% endif %}
  decoding="async"
>
